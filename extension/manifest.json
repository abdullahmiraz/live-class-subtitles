{
  "manifest_version": 3,
  "name": "Live Class Subtitles – Russian to 38 Languages",
  "short_name": "Live Class Subtitles",
  "version": "2.0.0",
  "minimum_chrome_version": "135",
  "description": "Live subtitles for Russian audio in any tab: English or 37 other languages. Nothing to install. Learn Russian as you listen.",
  "homepage_url": "https://github.com/abdullahmiraz/live-class-subtitles",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate.yandex.net/*",
    "https://browser.translate.yandex.net/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Live Class Subtitles",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Start/stop subtitles for the current tab"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
