{
  "manifest_version": 3,
  "name": "RU→EN Live Subtitles",
  "version": "1.2.0",
  "description": "Live Russian→English subtitles for any tab. Speech recognition runs on your own PC.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "downloads", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "RU→EN Live Subtitles" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "commands": {
    "toggle-capture": {
      "suggested_key": { "default": "Alt+Shift+Y" },
      "description": "Start/stop subtitles for the current tab"
    }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
